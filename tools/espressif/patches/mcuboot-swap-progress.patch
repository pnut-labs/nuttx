From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mateusz Pianka <1429923+piankma@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:00:00 +0000
Subject: [PATCH] bootutil, espressif: a swap's progress, for a board to show

swap-move tells boot_swap_progress() (bootutil_public.h) how far it has
got: done of total steps, each a sector moved up or one of a sector's
two copies, counted from the boot status on a resumed swap.  The
default, weak, does nothing.  The Espressif port builds a board's own
sources given as CONFIG_ESP_BOARD_SOURCES in the configuration file,
where a board can draw it.
---
 boot/bootutil/include/bootutil/bootutil_public.h | 12 ++++++++++
 boot/bootutil/src/swap_move.c                    | 30 ++++++++++++++++++++++++
 boot/espressif/CMakeLists.txt                    |  7 ++++++
 3 files changed, 49 insertions(+)

diff --git a/boot/bootutil/include/bootutil/bootutil_public.h b/boot/bootutil/include/bootutil/bootutil_public.h
index a0ee5872..56385469 100644
--- a/boot/bootutil/include/bootutil/bootutil_public.h
+++ b/boot/bootutil/include/bootutil/bootutil_public.h
@@ -355,6 +355,18 @@ int boot_remove_image_from_flash(struct boot_loader_state *state,
                                  uint32_t slot);
 #endif
 
+/**
+ * Told of a swap's progress, for a board to show it: done of total steps,
+ * each a sector moved up, or one of a sector's two copies (swap-move).  On
+ * a swap resumed after a reset, done starts from the steps already made.
+ * The default, weak, does nothing.
+ *
+ * @param swap_type  A BOOT_SWAP_TYPE_[...] constant.
+ * @param done       Steps made.
+ * @param total      Steps in the whole swap.
+ */
+void boot_swap_progress(int swap_type, uint32_t done, uint32_t total);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/boot/bootutil/src/swap_move.c b/boot/bootutil/src/swap_move.c
index 88a117f5..6cfdf349 100644
--- a/boot/bootutil/src/swap_move.c
+++ b/boot/bootutil/src/swap_move.c
@@ -485,6 +485,27 @@ fixup_revert(const struct boot_loader_state *state, struct boot_status *bs,
     }
 }
 
+/* The default: nothing shown (bootutil_public.h) */
+
+__attribute__((weak)) void
+boot_swap_progress(int swap_type, uint32_t done, uint32_t total)
+{
+    (void)swap_type;
+    (void)done;
+    (void)total;
+}
+
+static uint32_t
+swap_progress_done(const struct boot_status *bs, uint32_t last_idx)
+{
+    if (bs->op == BOOT_STATUS_OP_MOVE) {
+        return bs->idx - BOOT_STATUS_IDX_0;
+    }
+
+    return last_idx + (bs->idx - BOOT_STATUS_IDX_0) * 2 +
+           (bs->state == BOOT_STATUS_STATE_1 ? 1 : 0);
+}
+
 void
 swap_run(struct boot_loader_state *state, struct boot_status *bs,
          uint32_t copy_size)
@@ -537,11 +558,17 @@ swap_run(struct boot_loader_state *state, struct boot_status *bs,
 
     fixup_revert(state, bs, fap_sec);
 
+    boot_swap_progress(bs->swap_type, swap_progress_done(bs, last_idx),
+                       last_idx * 3);
+
     if (bs->op == BOOT_STATUS_OP_MOVE) {
         idx = last_idx;
         while (idx > 0) {
             if (idx <= (last_idx - bs->idx + 1)) {
                 boot_move_sector_up(idx, sector_sz, state, bs, fap_pri, fap_sec);
+                boot_swap_progress(bs->swap_type,
+                                   swap_progress_done(bs, last_idx),
+                                   last_idx * 3);
             }
             idx--;
         }
@@ -554,6 +581,9 @@ swap_run(struct boot_loader_state *state, struct boot_status *bs,
     while (idx <= last_idx) {
         if (idx >= bs->idx) {
             boot_swap_sectors(idx, sector_sz, state, bs, fap_pri, fap_sec);
+            boot_swap_progress(bs->swap_type,
+                               swap_progress_done(bs, last_idx),
+                               last_idx * 3);
         }
         idx++;
     }
diff --git a/boot/espressif/CMakeLists.txt b/boot/espressif/CMakeLists.txt
index 264cf8fd..ce07dc50 100644
--- a/boot/espressif/CMakeLists.txt
+++ b/boot/espressif/CMakeLists.txt
@@ -321,6 +321,13 @@ add_executable(
     ${CMAKE_CURRENT_LIST_DIR}/main.c
     )
 
+# A board's own sources, from CONFIG_ESP_BOARD_SOURCES in the
+# configuration file (which also passes it to the compiler, unused): its
+# boot_swap_progress(), say
+if(DEFINED CONFIG_ESP_BOARD_SOURCES)
+    target_sources(${APP_EXECUTABLE} PRIVATE ${CONFIG_ESP_BOARD_SOURCES})
+endif()
+
 target_compile_options(
     ${APP_EXECUTABLE}
     PUBLIC
