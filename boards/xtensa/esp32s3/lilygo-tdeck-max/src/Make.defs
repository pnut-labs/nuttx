CSRCS = esp32s3_boot.c esp32s3_bringup.c

ifeq ($(CONFIG_BOARDCTL_RESET),y)
CSRCS += esp32s3_reset.c
endif

ifeq ($(CONFIG_IOEXPANDER_PCA9555),y)
CSRCS += esp32s3_xl9555.c
endif

ifeq ($(CONFIG_ESP32S3_SPI2),y)
CSRCS += esp32s3_board_spi.c
endif

ifeq ($(CONFIG_LCD_UC8253),y)
CSRCS += esp32s3_board_lcd.c
endif

ifeq ($(CONFIG_INPUT_TCA8418),y)
CSRCS += esp32s3_tca8418.c
endif

ifeq ($(CONFIG_ESP32S3_SPI2)$(CONFIG_LPWAN_SX126X),yy)
CSRCS += esp32s3_lora.c
endif

ifneq ($(CONFIG_BQ27220)$(CONFIG_SY6970),)
CSRCS += esp32s3_battery.c
endif

# The touch controller's reset is one of the XL9555's lines

ifeq ($(CONFIG_INPUT_CST3530)$(CONFIG_IOEXPANDER_PCA9555),yy)
CSRCS += esp32s3_cst3530.c
endif

DEPPATH += --dep-path board
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board
